root = true

# A byte-order mark makes package.json invalid JSON for the DSH installer, so
# every file here is plain UTF-8 with no BOM. Node, npm, and the panel all
# accept LF; keeping it avoids the CRLF warnings git prints on Windows.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
