{
  "name": "@local/local-llm",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "author": "ahmadfarizoffice-dotcom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadfarizoffice-dotcom/dsh-local-llm.git"
  },
  "homepage": "https://github.com/ahmadfarizoffice-dotcom/dsh-local-llm#readme",
  "bugs": { "url": "https://github.com/ahmadfarizoffice-dotcom/dsh-local-llm/issues" },
  "description": "Runs a llama.cpp model on this computer and offers it to the Harness as a selectable model provider, managed from a panel in the left sidebar.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "llama.cpp",
    "local-llm",
    "gguf"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar"]
    }
  }
}
